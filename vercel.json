{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://api.support4funtalk.com/api/$1"
    },
    {
      "source": "/socket.io/(.*)",
      "destination": "https://api.support4funtalk.com/socket.io/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
